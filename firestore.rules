rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strict User-Specific Isolation
    // Each user can ONLY read and write documents inside their own /users/{userId} document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for anything outside /users/{userId}
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
