{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "User financial income, expense, or savings transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "categoryId": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income", "savings"] },
        "merchant": { "type": "string" },
        "notes": { "type": "string" },
        "goalId": { "type": "string" },
        "savingsRecordId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "date", "amount", "categoryId", "type", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "User budget category for expenses, income, or savings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income", "savings"] },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "isHappiness": { "type": "boolean" },
        "budgetMonthly": { "type": "number" }
      },
      "required": ["id", "userId", "name", "type", "icon", "color"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User savings target piggybank goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "title", "targetAmount", "currentAmount", "icon", "color"]
    },
    "SavingsRecord": {
      "title": "SavingsRecord",
      "description": "User savings deposit or withdrawal log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "goalId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "goalId", "type", "amount", "date", "createdAt"]
    },
    "FinancialRule": {
      "title": "FinancialRule",
      "description": "50/30/20 or custom financial allocation rule",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "needsPercent": { "type": "number" },
        "wantsPercent": { "type": "number" },
        "savingsPercent": { "type": "number" },
        "name": { "type": "string" }
      },
      "required": ["needsPercent", "wantsPercent", "savingsPercent"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Isolated transactions per authenticated user"
    },
    "/users/{userId}/categories/{catId}": {
      "schema": "Category",
      "description": "Isolated budget categories per authenticated user"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "Isolated savings goals per authenticated user"
    },
    "/users/{userId}/savingsRecords/{recId}": {
      "schema": "SavingsRecord",
      "description": "Isolated savings records per authenticated user"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "FinancialRule",
      "description": "Isolated financial rules and user settings"
    }
  }
}
